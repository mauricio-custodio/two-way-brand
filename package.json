{
	"name": "two-way-brand",
	"version": "0.2.0",
	"description": "TwoWay brand source of truth: colors as Mantine tuples and CSS variables, logo files, and a BrandLogo React component.",
	"private": true,
	"repository": "github:mauricio-custodio/two-way-brand",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./assets/*": "./assets/*",
		"./DESIGN.md": "./DESIGN.md",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"assets",
		"DESIGN.md"
	],
	"scripts": {
		"build": "rm -rf dist && node scripts/generate.mjs && tsc",
		"check": "npm run build && test -z \"$(git status --porcelain -- dist src/palette.generated.ts)\" || (echo 'Generated files are out of date: commit the rebuilt dist/ and src/palette.generated.ts.' && exit 1)"
	},
	"peerDependencies": {
		"@mantine/core": "^7.0.0 || ^8.0.0 || ^9.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@mantine/core": {
			"optional": true
		}
	},
	"devDependencies": {
		"@google/design.md": "0.4.0",
		"@mantine/core": "^9.8.0",
		"@types/react": "^19.3.0",
		"typescript": "^5.9.3"
	}
}
